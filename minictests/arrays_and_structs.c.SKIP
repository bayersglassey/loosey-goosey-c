#include <stdio.h>

typedef struct T { int x; int y; int data[2]; } T;

void print_struct(T *t) {
    printf("{ .x = %i, .y = %i, .data = {%i, %i} }\n", t->x, t->y, t->data[0], t->data[1]);
}

int main() {
    T t = {1, 2};
    T tt[] = {{1, 2, {10, 20}}, {3, 4, {30, 40}}};
    int i;
    printf("t = "); print_struct(&t);
    for (i = 0; i < 2; i += 1) {
        printf("tt[%i] = ", i);
        print_struct(&tt[i]);
    }
    return 0;
}
